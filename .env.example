# Copy to .env for local development, and set the same variables in your host
# (Vercel / Netlify / Cloudflare Pages → Project settings → Environment variables).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Public URL of the web app (share links, auth emails, native app)
VITE_SITE_URL=https://roadmigo.app
